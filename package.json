{
  "name": "pushform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Free, open-source push/pull 3D modeling in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/vitest.mjs run",
    "test:watch": "node scripts/vitest.mjs",
    "test:stress": "node scripts/vitest.mjs run --config vitest.stress.config.ts"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "earcut": "^3.2.4",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
